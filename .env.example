# ── MauleMed Frontend — Variables de entorno ─────────────────────────────────
# Copia este archivo como .env y rellena los valores para tu entorno.
# El archivo .env real está en .gitignore y nunca se debe commitear.

# URL base de la API del backend (sin trailing slash)
# Desarrollo local:
VITE_API_BASE_URL=http://localhost:8000/api
# Producción (ejemplo):
# VITE_API_BASE_URL=https://api.maulemed.cl/api

# Google OAuth — Client ID del proyecto en Google Cloud Console
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
